# Twelve Data API 키 (Venture 610 플랜)
# https://twelvedata.com → API Keys에서 발급
TWELVE_DATA_API_KEY=your_key_here

# Brandfetch Client ID (선택)
# https://brandfetch.com/developers → API Keys에서 발급
# 없으면 공개 CDN(logo.brandfetch.io)으로 자동 fallback
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# 공공데이터포털 금융위원회_주식시세정보 인증키 (KOSPI/KOSDAQ 시세·시총·순위)
# https://www.data.go.kr → "금융위원회_주식시세정보" 검색 → 활용신청(즉시 승인) → 마이페이지에서 발급
# ⚠️ "Decoding(일반 인증키)"를 넣을 것 (Encoding 키 아님). 미설정 시 코스피/코스닥 섹션은 503.
# EOD(장 마감 후) 데이터라 영업일 기준 하루 지연(D-1)이며 장중 실시간 시세는 제공하지 않는다.
DATA_GO_KR_KEY=

# DART(전자공시) Open API 인증키 (KOSPI/KOSDAQ 신규 종목 로고 도메인 자동 해석)
# https://opendart.fss.or.kr → 인증키 신청/관리 → API 인증키 신청(무료, 즉시 발급)
# 종목코드 → 기업 홈페이지 도메인을 뽑아 앱이 Clearbit/Brandfetch/파비콘 로고를 핫링크한다.
# 미설정 시 신규 종목은 로고 없이 텍스트 이니셜로 표시된다(가격/시총 기능엔 영향 없음).
DART_API_KEY=

# 한국수출입은행 환율 Open API 인증키 (지수 섹션 달러 환율)
# https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2&viewtype=C → 본인인증 후 발급(무료)
# 미설정 시 Yahoo(KRW=X)로 자동 폴백. 신규 도메인 oapi.koreaexim.go.kr 사용, 일 1,000회 제한.
KOREAEXIM_API_KEY=

# 출시 투표(하트) 집계 + KR/US 시총 스냅샷 저장소 — Upstash Redis (서버리스 배포 필수)
# https://console.upstash.com → Redis DB 생성 → REST API 섹션에서 발급
# 미설정 시 로컬 .data/*.json 파일로 폴백(dev/VPS 전용, 서버리스 배포엔 부적합).
# 이 하나로 launch-votes / kr-snapshot / us-stats 스냅샷을 모두 보관한다(key로 분리).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 내부 refresh 라우트(/api/internal/refresh-kr·refresh-us) 보호용 시크릿 (로컬·수동 트리거).
# 아무 랜덤 문자열(예: openssl rand -hex 32). 헤더 x-refresh-secret / ?secret= / Bearer 중 하나로 전달.
# ⚠️ US 시총 스냅샷의 프로덕션 정기 갱신은 이 라우트가 아니라 GitHub Actions
#    (.github/workflows/refresh-us.yml)가 러너에서 scripts/refresh-us-stats.ts 를 직접 돌려
#    Upstash에 write 한다. 그 Action은 GitHub repo Secrets 에 다음을 요구:
#    TWELVE_DATA_API_KEY, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN.
REFRESH_SECRET=
CRON_SECRET=
